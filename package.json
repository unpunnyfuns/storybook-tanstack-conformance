{
  "name": "storybook-tanstack-conformance",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "test": "npm run test --workspaces",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxfmt --check && oxlint --deny-warnings && node scripts/assert-csf-modes.mjs && node scripts/docs.mjs --check && npm run typecheck --workspaces",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.71.0"
  }
}
